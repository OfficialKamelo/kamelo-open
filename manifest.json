{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.7.2",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://kamelo.eu",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://*.chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://*.gemini.google.com/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://copilot.microsoft.com/*",
    "https://*.copilot.microsoft.com/*",
    "https://copilot.com/*",
    "https://*.copilot.com/*",
    "https://copilot.cloud.microsoft/*",
    "https://*.copilot.cloud.microsoft/*",
    "https://perplexity.ai/*",
    "https://*.perplexity.ai/*",
    "https://chat.mistral.ai/*",
    "https://*.chat.mistral.ai/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://chat.deepseek.com/*",
    "https://*.chat.deepseek.com/*",
    "https://meta.ai/*",
    "https://*.meta.ai/*",
    "https://web.whatsapp.com/*",
    "https://*.web.whatsapp.com/*",
    "https://m365.cloud.microsoft/*",
    "https://*.m365.cloud.microsoft/*",
    "https://aistudio.google.com/*",
    "https://*.aistudio.google.com/*",
    "https://notebooklm.google.com/*",
    "https://*.notebooklm.google.com/*",
    "https://poe.com/*",
    "https://*.poe.com/*",
    "https://you.com/*",
    "https://*.you.com/*",
    "https://chat.qwen.ai/*",
    "https://*.chat.qwen.ai/*",
    "https://duck.ai/*",
    "https://*.duck.ai/*",
    "https://character.ai/*",
    "https://*.character.ai/*",
    "https://pi.ai/*",
    "https://*.pi.ai/*",
    "https://typingmind.com/*",
    "https://*.typingmind.com/*",
    "https://phind.com/*",
    "https://*.phind.com/*",
    "https://kimi.com/*",
    "https://*.kimi.com/*",
    "https://z.ai/*",
    "https://*.z.ai/*"
  ],
  "action": {
    "default_title": "Melo",
    "default_popup": "popup/public.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "chat/chat.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://*.chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://*.gemini.google.com/*",
        "https://claude.ai/*",
        "https://*.claude.ai/*",
        "https://copilot.microsoft.com/*",
        "https://*.copilot.microsoft.com/*",
        "https://copilot.com/*",
        "https://*.copilot.com/*",
        "https://copilot.cloud.microsoft/*",
        "https://*.copilot.cloud.microsoft/*",
        "https://perplexity.ai/*",
        "https://*.perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://*.chat.mistral.ai/*",
        "https://grok.com/*",
        "https://*.grok.com/*",
        "https://chat.deepseek.com/*",
        "https://*.chat.deepseek.com/*",
        "https://meta.ai/*",
        "https://*.meta.ai/*",
        "https://web.whatsapp.com/*",
        "https://*.web.whatsapp.com/*",
        "https://m365.cloud.microsoft/*",
        "https://*.m365.cloud.microsoft/*",
        "https://aistudio.google.com/*",
        "https://*.aistudio.google.com/*",
        "https://notebooklm.google.com/*",
        "https://*.notebooklm.google.com/*",
        "https://poe.com/*",
        "https://*.poe.com/*",
        "https://you.com/*",
        "https://*.you.com/*",
        "https://chat.qwen.ai/*",
        "https://*.chat.qwen.ai/*",
        "https://duck.ai/*",
        "https://*.duck.ai/*",
        "https://character.ai/*",
        "https://*.character.ai/*",
        "https://pi.ai/*",
        "https://*.pi.ai/*",
        "https://typingmind.com/*",
        "https://*.typingmind.com/*",
        "https://phind.com/*",
        "https://*.phind.com/*",
        "https://kimi.com/*",
        "https://*.kimi.com/*",
        "https://z.ai/*",
        "https://*.z.ai/*"
      ],
      "js": [
        "src/edition.js",
        "src/strings.js",
        "src/sites.js",
        "src/config.js",
        "src/topic-words.js",
        "src/topics.js",
        "src/topic-ai.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "default_locale": "en",
  "short_name": "Melo"
}
